# Скопируйте в .env (он не попадает в репозиторий) и заполните.

PUBLIC_URL=https://feel.meowtreach.com
# Длинная случайная строка: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Ключи для уведомлений: python -m app.cli gen-vapid
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@meowtreach.com

# Регистрация закрыта; первого пользователя создаёт python -m app.cli create-user
REGISTRATION_OPEN=false

# База, медиа, блокировки. Путь относительно корня проекта или абсолютный.
# Папка должна быть вне публичной папки сайта.
VAR_DIR=var

DEFAULT_TIMEZONE=Europe/Moscow
SESSION_DAYS=90
USER_QUOTA_MB=1024

# Для локальной разработки по http://localhost:
# COOKIE_SECURE=false
# FORCE_HTTPS=false
